<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="Developer Features">

        <SwitchPreferenceCompat
            app:key="feature_flag_developer_dashboard"
            app:title="Developer Diagnostics"
            app:summary="Enable hardware, memory, PTY, and SDK runtime inspector."
            app:defaultValue="true" />

        <Preference
            app:key="open_dev_dashboard"
            app:title="Open Developer Dashboard"
            app:summary="View real-time system metrics, git hash, RAM, and ABIs."
            app:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="Build Architecture">

        <Preference
            app:key="build_mode_info"
            app:title="Target SDK Mode"
            app:summary="Target SDK 28 (W^X execution safety preserved)"
            app:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
