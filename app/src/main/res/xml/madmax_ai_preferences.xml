<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="AI Assistant (Phase 2 Preview)">

        <SwitchPreferenceCompat
            app:key="feature_flag_ai_assistant"
            app:title="Enable AI Assistant"
            app:summary="Contextual shell suggestions and CLI error explanation."
            app:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        app:title="AI Provider Settings (Coming in Phase 2)">

        <Preference
            app:key="ai_provider_info"
            app:title="Supported Providers"
            app:summary="Local models (Ollama/llama.cpp), OpenAI, Gemini, Anthropic."
            app:persistent="false" />

        <Preference
            app:key="ai_privacy_info"
            app:title="Privacy &amp; Data Boundary"
            app:summary="Zero terminal buffer telemetry without explicit opt-in."
            app:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
