<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ai_workspace_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/madmax_surface_dark"
    android:paddingBottom="16dp">

    <!-- Drag Handle -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="#4A4A52" />

    <!-- AI Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp">

        <!-- Icon Container Badge -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_ai_icon_badge">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ai_workspace"
                app:tint="#CE93D8"
                android:contentDescription="AI Workspace" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Command Workspace"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F4F4F6" />

            <TextView
                android:id="@+id/ai_provider_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline Engine • Zero Network Latency"
                android:textSize="11sp"
                android:textColor="#8E8E93" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_ai_sheet"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#8E8E93"
            android:contentDescription="Close" />

    </LinearLayout>

    <!-- Material 3 Tab Layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/ai_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorColor="#CE93D8"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="#CE93D8"
        app:tabTextColor="#8E8E93"
        app:tabIconTint="#CE93D8"
        app:tabInlineLabel="true"
        app:tabTextAppearance="@style/MadMax.TabTextAppearance"
        android:background="@color/madmax_surface_dark" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#222228" />

    <!-- Scrollable Container for Active Tab -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:id="@+id/ai_tab_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="260dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
