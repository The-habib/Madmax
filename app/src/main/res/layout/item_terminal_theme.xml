<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="#16161C"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#24242C"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <!-- Theme Mini Terminal Preview Box -->
        <FrameLayout
            android:id="@+id/theme_preview_box"
            android:layout_width="66dp"
            android:layout_height="48dp"
            android:background="#0E0E12"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/theme_preview_text1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ madmax"
                    android:textColor="#34C759"
                    android:textSize="8sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/theme_preview_text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ready █"
                    android:textColor="#F0F0F4"
                    android:textSize="8sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </FrameLayout>

        <!-- Theme Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/theme_item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="MadMax Cyber Dark" />

                <TextView
                    android:id="@+id/theme_active_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="ACTIVE"
                    android:textColor="#30D158"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:background="@drawable/bg_session_running_pill"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/theme_item_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="Signature obsidian dark theme with cyber red accents" />

            <!-- Swatches row -->
            <LinearLayout
                android:id="@+id/theme_swatches_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp">

                <View
                    android:id="@+id/swatch_1"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp" />
                <View
                    android:id="@+id/swatch_2"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp" />
                <View
                    android:id="@+id/swatch_3"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp" />
                <View
                    android:id="@+id/swatch_4"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp" />
                <View
                    android:id="@+id/swatch_5"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="4dp" />
                <View
                    android:id="@+id/swatch_6"
                    android:layout_width="10dp"
                    android:layout_height="10dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Selected check icon -->
        <ImageView
            android:id="@+id/theme_selected_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check"
            app:tint="#FF3B30"
            android:visibility="gone"
            android:contentDescription="Selected Theme"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
