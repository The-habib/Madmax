<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/terminal_toolbar_quick_actions_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:background="#0A0A0C">

    <LinearLayout
        android:id="@+id/terminal_toolbar_quick_actions_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="3dp">

        <!-- MENU Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_quick_menu"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#60FF3B30"
            app:backgroundTint="#241414"
            app:rippleColor="#40FF3B30"
            app:icon="@drawable/ic_quick_actions"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="@color/madmax_primary"
            android:text="MENU"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Open Quick Actions and Accessibility Menu" />

        <!-- PALETTE (CMD) Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_palette"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#5064D2FF"
            app:backgroundTint="#14222B"
            app:rippleColor="#4064D2FF"
            app:icon="@drawable/ic_explain"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#64D2FF"
            android:text="CMD"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Open Spotlight Command Palette" />

        <!-- THEME Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_theme"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#50BF5AF2"
            app:backgroundTint="#211526"
            app:rippleColor="#40BF5AF2"
            app:icon="@drawable/ic_palette"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#BF5AF2"
            android:text="THEME"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Select Terminal Color Theme" />

        <!-- AI Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_ai"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#50CE93D8"
            app:backgroundTint="#211526"
            app:rippleColor="#40CE93D8"
            app:icon="@drawable/ic_ai_workspace"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#CE93D8"
            android:text="AI"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Open AI Command Workspace" />

        <!-- PASTE Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_paste"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_paste"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#80DEEA"
            android:text="PASTE"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Paste text from clipboard" />

        <!-- CLEAR Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_clear"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_clear_all"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#B0BEC5"
            android:text="CLEAR"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Clear terminal screen" />

        <!-- CTRL+C Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_ctrl_c"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#50FF5252"
            app:backgroundTint="#261616"
            app:rippleColor="#40FF5252"
            app:icon="@drawable/ic_stop"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#FF5252"
            android:text="^C"
            android:textColor="#FF8A80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Interrupt running process" />

        <!-- SNIPS Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_snippets"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_snippets"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#FFE082"
            android:text="SNIPS"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Quick command snippets" />

        <!-- ZOOM IN (A+) Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_zoom_in"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_zoom_in"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#90CAF9"
            android:text="A+"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Increase font size" />

        <!-- ZOOM OUT (A-) Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_zoom_out"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_zoom_out"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#90CAF9"
            android:text="A-"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Decrease font size" />

        <!-- KEYBOARD Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_keyboard"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#E0E0E0"
            android:text="KBD"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Toggle virtual keyboard" />

        <!-- COPY Key -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toolbar_copy_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginHorizontal="2.5dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2E2E38"
            app:backgroundTint="#1D1D24"
            app:rippleColor="#33FFFFFF"
            app:icon="@drawable/ic_copy"
            app:iconSize="13dp"
            app:iconPadding="5dp"
            app:iconGravity="textStart"
            app:iconTint="#A5D6A7"
            android:text="COPY"
            android:textColor="#F0F0F2"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:contentDescription="Copy terminal screen text" />

    </LinearLayout>
</HorizontalScrollView>
